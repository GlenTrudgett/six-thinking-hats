# Copy to .env (never commit .env). Real values only in your environment.
SIXHATS_LLM__PROVIDER=anthropic
SIXHATS_LLM__MODEL=claude-sonnet-5-5
SIXHATS_LLM__ANTHROPIC_API_KEY=
# Local OpenAI-compatible server (loopback only unless allow_non_loopback is set)
SIXHATS_LLM__LOCAL__BASE_URL=http://127.0.0.1:11434/v1
